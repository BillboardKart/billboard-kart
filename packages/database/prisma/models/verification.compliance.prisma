model VerificationDocument {
  id              String         @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  ownerId         String?        @map("owner_id") @db.Uuid
  billboardId     String?        @map("billboard_id") @db.Uuid
  documentType    String         @map("document_type")
  documentNumber  String?        @map("document_number")
  fileUrl         String         @map("file_url")
  status          DocumentStatus @default(pending)
  reviewedBy      String?        @map("reviewed_by") @db.Uuid
  reviewedAt      DateTime?      @map("reviewed_at") @db.Timestamptz(6)
  rejectionReason String?        @map("rejection_reason")
  expiresAt       DateTime?      @map("expires_at") @db.Timestamptz(6)
  createdAt       DateTime       @default(now()) @map("created_at") @db.Timestamptz(6)
  billboard       Billboard?     @relation(fields: [billboardId], references: [id])
  owner           User?          @relation("VerificationDocumentOwner", fields: [ownerId], references: [id])
  reviewer        User?          @relation("VerificationDocumentReviewer", fields: [reviewedBy], references: [id])

  @@index([ownerId])
  @@index([billboardId])
  @@map("verification_documents")
}
